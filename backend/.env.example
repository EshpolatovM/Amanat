NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:1234@127.0.0.1:5432/amanat?schema=public"

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_SECURE=false

CORS_ORIGIN=http://localhost:5173

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=amanat_helpbot

# Reverse-proxy (nginx) ortida ishlaganda "true" qiling — rate-limit mijozning haqiqiy IP'sini ko'rishi uchun
TRUST_PROXY=false

# "Bugun"/joriy oy va kundalik xarajatlar shu vaqt mintaqasi bo'yicha hisoblanadi
APP_TIMEZONE=Asia/Tashkent
