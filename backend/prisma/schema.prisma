generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  parent
  child
}

enum RecurringFrequency {
  weekly
  monthly
}

enum PasswordResetStatus {
  pending_telegram
  otp_sent
  verified
  used
  expired
}

model Parent {
  id           String   @id @default(uuid())
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  children Child[]

  @@map("parents")
}

model Child {
  id           String   @id @default(uuid())
  parentId     String   @map("parent_id")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  age          Int
  phone        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent Parent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  goals              Goal[]
  plannedExpenses    PlannedExpense[]
  recurringRules     RecurringRule[]
  recurringInstances RecurringExpenseInstance[]
  unplannedExpenses  UnplannedExpense[]

  @@index([parentId])
  @@map("children")
}

model Goal {
  id        String   @id @default(uuid())
  childId   String   @map("child_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  child              Child                      @relation(fields: [childId], references: [id], onDelete: Cascade)
  plannedExpenses    PlannedExpense[]
  recurringRules     RecurringRule[]
  recurringInstances RecurringExpenseInstance[]

  @@index([childId])
  @@map("goals")
}

model PlannedExpense {
  id        String   @id @default(uuid())
  childId   String   @map("child_id")
  goalId    String   @map("goal_id")
  amount    BigInt
  date      DateTime @db.Date
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@index([childId])
  @@index([goalId])
  @@index([date])
  @@map("planned_expenses")
}

// `goalId` ixtiyoriy: bo'lmasa, bu klassik "kundalik xarajat" qoidasi
// (TZ 3.4, statistikada "Kundalik xarajat" sifatida hisoblanadi). Belgilansa,
// generatsiya qilingan yozuvlar shu maqsadning "Maqsadli xarajat"iga qo'shiladi
// (masalan "Kurs puli" uchun har oyning 5-sanasida avtomatik to'lov).
model RecurringRule {
  id         String             @id @default(uuid())
  childId    String             @map("child_id")
  goalId     String?            @map("goal_id")
  amount     BigInt
  frequency  RecurringFrequency @default(weekly)
  daysOfWeek Int[]              @default([]) @map("days_of_week")
  dayOfMonth Int?               @map("day_of_month")
  startDate  DateTime           @db.Date @map("start_date")
  endDate    DateTime?          @db.Date @map("end_date")
  comment    String?
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  child     Child                      @relation(fields: [childId], references: [id], onDelete: Cascade)
  goal      Goal?                      @relation(fields: [goalId], references: [id], onDelete: Restrict)
  instances RecurringExpenseInstance[]

  @@index([childId])
  @@index([goalId])
  @@map("recurring_rules")
}

model RecurringExpenseInstance {
  id        String   @id @default(uuid())
  ruleId    String   @map("rule_id")
  childId   String   @map("child_id")
  goalId    String?  @map("goal_id")
  amount    BigInt
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  rule  RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  child Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  goal  Goal?         @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@unique([ruleId, date])
  @@index([childId])
  @@index([date])
  @@index([goalId])
  @@map("recurring_expense_instances")
}

model UnplannedExpense {
  id        String   @id @default(uuid())
  childId   String   @map("child_id")
  amount    BigInt
  reason    String
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([date])
  @@map("unplanned_expenses")
}

// Ota-ona parolini Telegram bot (@amanat_helpbot) orqali tiklash sessiyasi.
// `id` bot deep-link (`t.me/<bot>?start=<id>`) payloadi sifatida ham ishlatiladi.
// `chatId` faqat foydalanuvchi botda Start bosgach to'ldiriladi, telefon raqami
// Telegram'ning o'z `request_contact` mexanizmi orqali tasdiqlangandan keyingina
// OTP shu chatga yuboriladi (TZ 6.1).
model PasswordResetRequest {
  id                  String              @id @default(uuid())
  phone               String
  chatId              String?             @map("chat_id")
  status              PasswordResetStatus @default(pending_telegram)
  otpHash             String?             @map("otp_hash")
  otpExpiresAt        DateTime?           @map("otp_expires_at")
  otpAttempts         Int                 @default(0) @map("otp_attempts")
  resetTokenHash      String?             @map("reset_token_hash")
  resetTokenExpiresAt DateTime?           @map("reset_token_expires_at")
  expiresAt           DateTime            @map("expires_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@index([phone])
  @@index([chatId])
  @@map("password_reset_requests")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  userType  UserType  @map("user_type")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
